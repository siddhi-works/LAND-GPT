{
  "version": "1.0.0",
  "description": "Deterministic semantic glossary connecting Maharashtra, Uttar Pradesh and Gujarat land-system terminology to the canonical Land Stack concepts. Resolution is exact-match only (Unicode NFKC + casefold + whitespace collapse) on either the English/transliterated value or the native-script value. No fuzzy or model-based matching. State '*' entries apply to every state and are consulted only after state-specific entries.",
  "concepts": {
    "parcel": {"label": "Parcel", "definition": "A unit of land identified by a ULPIN, located in a state jurisdiction and known natively by a survey/gat/khasra/CTS number.", "canonical_record": "ParcelIdentity", "endpoints": ["/v1/registry/ulpin/{ulpin}", "/v1/parcels/{ulpin}"]},
    "ownership": {"label": "Ownership", "definition": "A claim of a party over a parcel: recorded holder (khatedar/holder in a record of rights or property card) or registered transferee/transferor in a registered instrument.", "canonical_record": "OwnershipClaim", "endpoints": ["/v1/parcels/{ulpin}/ownership"]},
    "land_record": {"label": "Land record", "definition": "A revenue or survey record describing rights, holding, area and use of a parcel (record of rights, holding account, plot register, urban property record).", "canonical_record": "LandRecord", "endpoints": ["/v1/parcels/{ulpin}/land-records", "/v1/parcels/{ulpin}/profile"]},
    "registration": {"label": "Registration", "definition": "An instrument registered with a Sub-Registrar (sale deed, gift deed, ...), recording parties, consideration and dates.", "canonical_record": "Registration", "endpoints": ["/v1/parcels/{ulpin}/registration"]},
    "mutation": {"label": "Mutation", "definition": "A revenue entry that changes the record of rights following a transfer, succession, charge or order.", "canonical_record": "Mutation", "endpoints": ["/v1/parcels/{ulpin}/mutation"]},
    "encumbrance": {"label": "Encumbrance", "definition": "A charge, mortgage or other liability registered against a parcel.", "canonical_record": "Encumbrance", "endpoints": ["/v1/parcels/{ulpin}/encumbrance"]},
    "litigation": {"label": "Litigation", "definition": "A court/revenue case flagged against a parcel. In the supplied data this is only available as a flag and case reference on encumbrance records.", "canonical_record": "Litigation", "endpoints": ["/v1/parcels/{ulpin}/encumbrance"]},
    "land_use": {"label": "Land use", "definition": "The use class recorded for the parcel in the land record (agricultural, residential, commercial).", "canonical_record": "LandUse", "endpoints": ["/v1/parcels/{ulpin}/planning"]},
    "planning": {"label": "Planning", "definition": "Zoning/permitted use under a regional or development plan and any planning restriction.", "canonical_record": "PlanningRecord", "endpoints": ["/v1/parcels/{ulpin}/planning"]},
    "building_permission": {"label": "Building permission", "definition": "Approval of a building plan by a planning/development authority.", "canonical_record": "BuildingPermission", "endpoints": ["/v1/parcels/{ulpin}/building"]},
    "property_tax": {"label": "Property tax", "definition": "Municipal/local-body property tax assessment, demand and payment.", "canonical_record": "PropertyTax", "endpoints": ["/v1/parcels/{ulpin}/tax"]},
    "utilities": {"label": "Utilities", "definition": "Electricity, water and road-access service status linked to the parcel.", "canonical_record": "UtilityService", "endpoints": ["/v1/parcels/{ulpin}/utilities"]},
    "environmental_restriction": {"label": "Environmental restriction", "definition": "An environmental control (buffer, coastal, eco-sensitive) applying to the parcel.", "canonical_record": "EnvironmentalRestriction", "endpoints": ["/v1/parcels/{ulpin}/planning"]},
    "geometry": {"label": "Geometry", "definition": "Cadastral boundary polygon of the parcel and any cadastral-map record describing it.", "canonical_record": "CadastralGeometry / CadastralMapRecord", "endpoints": ["/v1/parcels/{ulpin}/gis"]}
  },
